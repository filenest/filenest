      "module": "./dist/client.js",
      "require": "./dist/client.js"
    }
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsup src/index.ts src/client.ts --dts --format cjs,esm --sourcemap",
    "dev": "tsup src/index.ts src/client.ts --dts --sourcemap --watch",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@internal/eslint": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "eslint": "9.21.0",
    "tsup": "^8.4.0"
  },
  "dependencies": {
    "@filenest/core": "0.7.1"
  },
  "peerDependencies": {
    "@trpc/server": "^11",
    "zod": ">= 3.20.0"
  },
  "engines": {
    "pnpm": ">=10.0.0"
