{
  "name": "root",
  "private": true,
  "scripts": {
    "docs:dev": "turbo dev --filter=\"./docs\"",
    "docs:build": "turbo build --filter=\"./docs\"",
    "dev": "turbo dev --filter=\"@filenest/*\"",
    "prebuild": "turbo build --filter=\"@filenest/core\"",
    "build": "turbo build --filter=\"@filenest/*\"",
    "lint": "pnpm --filter=\"@filenest/*\" run lint",
    "publish-release": "pnpm install --frozen-lockfile=false && pnpm build && pnpm changeset publish"
  },
  "packageManager": "pnpm@10.4.0",
  "engines": {
    "pnpm": ">=9.7.0",
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "turbo": "^2.0.12"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@changesets/get-github-info": "0.6.0",
    "dotenv": "16.5.0",
    "tsx": "^4.19.3"
  }
}